"key":"span.kind","type":"string","value":"internal"}],"logs":[],"processID":"p2","warnings":null},{"traceID":"385aa95dcc0188f8d778f9f54e236657","spanID":"e71abfb775c27acf","operationName":"HTTP POST","references":[{"refType":"CHILD_OF","traceID":"385aa95dcc0188f8d778f9f54e236657","spanID":"1fd6effcfc5023c0"}],"startTime":1789293097297166,"duration":22478,"tags":[{"key":"otel.scope.name","type":"string","value":"OpenTelemetry::Instrumentation::Rack"},{"key":"otel.scope.version","type":"string","value":"0.26.0"},{"key":"http.host","type":"string","value":"authorization-service"},{"key":"http.method","type":"string","value":"POST"},{"key":"http.scheme","type":"string","value":"http"},{"key":"http.status_code","type":"int64","value":200},{"key":"http.target","type":"string","value":"/can/Account/account.read"},{"key":"http.user_agent","type":"string","value":"Faraday v2.13.2"},{"key":"span.kind","type":"string","value":"server"}],"logs":[],"processID":"p2","warnings":null},{"traceID":"385aa95dcc0188f8d778f9f54e236657","spanID":"d02566351ea812da","operationName":"SQL AccountsWithParentsSetCTE","references":[{"refType":"CHILD_OF","traceID":"385aa95dcc0188f8d778f9f54e236657","spanID":"901c9b0c8297a80e"}],"startTime":1789293097352488,"duration":1647,"tags":[{"key":"otel.scope.name","type":"string","value":"iam.application_sql"},{"key":"db.name","type":"string","value":"account-db_production"},{"key":"db.query.name","type":"string","value":"AccountsWithParentsSetCTE"},{"key":"db.statement","type":"string","value":"WITH RECURSIVE roots(root_id, organization_id, seed_ids) AS (\n  VALUES ($1::uuid, $2::uuid, $3::uuid[]),\n               ($4::uuid, $5::uuid, $6::uuid[]),\n               ($7::uuid, $8::uuid, $9::uuid[]),\n               ($10::uuid, $11::uuid, $12::uuid[]),\n               ($13::uuid, $14::uuid, $15::uuid[]),\n               ($16::uuid, $17::uuid, $18::uuid[]),\n               ($19::uuid, $20::uuid, $21::uuid[]),\n               ($22::uuid, $23::uuid, $24::uuid[])\n),\naccount_ancestry(root_id, organization_id, id, parent_account_id, name, level, path) AS (\n  SELECT roots.root_id, roots.organization_id, accounts.id, accounts.parent_account_id, accounts.name, 0 AS level, ARRAY[accounts.id]::uuid[] AS path\n  FROM roots\n  INNER JOIN accounts ON accounts.id = roots.root_id\n\n  UNION ALL\n\n  SELECT account_ancestry.root_id, account_ancestry.organization_id, parents.id, parents.parent_account_id, parents.name, account_ancestry.level + 1, account_ancestry.path || parents.id\n  FROM account_ancestry\n  INNER JOIN roots ON roots.root_id = account_ancestry.root_id\n  INNER JOIN accounts parents ON parents.id = account_ancestry.parent_account_id\n  WHERE parents.id = ANY(roots.seed_ids)\n    AND NOT parents.id = ANY(account_ancestry.path)\n    AND account_ancestry.level + 1 < 100\n)\nSELECT root_id, organization_id, id, parent_account_id, name, level\nFROM account_ancestry\nORDER BY root_id, level DESC\n /*action='accounts_with_parents',application='AccountService',controller='accounts'*/"},{"key":"db.system","type":"string","value":"postgresql"},{"key":"span.kind","type":"string","value":"client"}],"logs":[],"processID":"p3","warnings":null},{"traceID":"385aa95dcc0188f8d778f9f54e236657","spanID":"1fd6effcfc5023c0","operationName":"HTTP POST","references":[{"refType":"CHILD_OF","traceID":"385aa95dcc0188f8d778f9f54e236657","spanID":"901c9b0c8297a80e"}],"startTime":1789293097296804,"duration":23378,"tags":[{"key":"otel.scope.name","type":"string","value":"OpenTelemetry::Instrumentation::Net::HTTP"},{"key":"otel.scope.version","type":"string","value":"0.23.0"},{"key":"http.method","type":"string","value":"POST"},{"key":"http.scheme","type":"string","value":"http"},{"key":"http.status_code","type":"int64","value":200},{"key":"http.target","type":"string","value":"/can/Account/account.read"},{"key":"net.peer.name","type":"string","value":"authorization-service"},{"key":"net.peer.port","type":"int64","value":80},{"key":"span.kind","typ