stry(root_id, organization_id, id, parent_account_id, name, level, path) AS (\n  SELECT roots.root_id, roots.organization_id, accounts.id, accounts.parent_account_id, accounts.name, 0 AS level, ARRAY[accounts.id]::uuid[] AS path\n  FROM roots\n  INNER JOIN accounts ON accounts.id = roots.root_id\n\n  UNION ALL\n\n  SELECT account_ancestry.root_id, account_ancestry.organization_id, parents.id, parents.parent_account_id, parents.name, account_ancestry.level + 1, account_ancestry.path || parents.id\n  FROM account_ancestry\n  INNER JOIN roots ON roots.root_id = account_ancestry.root_id\n  INNER JOIN accounts parents ON parents.id = account_ancestry.parent_account_id\n  WHERE parents.id = ANY(roots.seed_ids)\n    AND NOT parents.id = ANY(account_ancestry.path)\n    AND account_ancestry.level + 1 < 100\n)\nSELECT root_id, organization_id, id, parent_account_id, name, level\nFROM account_ancestry\nORDER BY root_id, level DESC\n /*action='accounts_with_parents',application='AccountService',controller='accounts'*/"},{"key":"db.system","type":"string","value":"postgresql"},{"key":"span.kind","type":"string","value":"client"}],"logs":[],"processID":"p4","warnings":null},{"traceID":"fce51f95cfe42d7d4174d810549d1369","spanID":"ca9a213f02687d22","operationName":"HTTP POST","references":[{"refType":"CHILD_OF","traceID":"fce51f95cfe42d7d4174d810549d1369","spanID":"d4b2dd7dcb941000"}],"startTime":1789293096875563,"duration":10232,"tags":[{"key":"otel.scope.name","type":"string","value":"OpenTelemetry::Instrumentation::Rack"},{"key":"otel.scope.version","type":"string","value":"0.26.0"},{"key":"http.host","type":"string","value":"account-auth-service"},{"key":"http.method","type":"string","value":"POST"},{"key":"http.scheme","type":"string","value":"http"},{"key":"http.status_code","type":"int64","value":200},{"key":"http.target","type":"string","value":"/accounts_with_parents"},{"key":"http.user_agent","type":"string","value":"Ruby"},{"key":"span.kind","type":"string","value":"serv