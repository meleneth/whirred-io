id, name, level\nFROM account_ancestry\nORDER BY root_id, level DESC\n ?"},{"key":"db.system","type":"string","value":"postgresql"},{"key":"db.user","type":"string","value":"account-db-production-user"},{"key":"net.peer.ip","type":"string","value":"172.21.0.25"},{"key":"net.peer.name","type":"string","value":"account-db"},{"key":"net.peer.port","type":"int64","value":5432},{"key":"net.transport","type":"string","value":"ip_tcp"},{"key":"span.kind","type":"string","value":"client"}],"logs":[],"processID":"p1","warnings":["parent span ID=27672be7f6292f4f is not in the trace; skipping clock skew adjustment","parent span ID=27672be7f6292f4f is not in the trace; skipping clock skew adjustment","parent span ID=27672be7f6292f4f is not in the trace; skipping clock skew adjustment","parent span ID=27672be7f6292f4f is not in the trace; skipping clock skew adjustment","parent span ID=27672be7f6292f4f is not in the trace; skipping clock skew adjustment","parent span ID=27672be7f6292f4f is not in the trace; skipping clock skew adjustment"]},{"traceID":"eeeb5557d8be54a48a0d742a82528b0c","spanID":"ff6657cda5f5b110","operationName":"organization_accounts.lookup","references":[{"refType":"CHILD_OF","traceID":"eeeb5557d8be54a48a0d742a82528b0c","spanID":"27672be7f6292f4f"}],"startTime":1789289904566923,"duration":10455,"tags":[{"key":"otel.scope.name","type":"string","value":"account-service"},{"key":"phase.elapsed_ms","type":"float64","value":10.432073991978541},{"key":"scope.count","type":"int64","value":8},{"key":"span.kind","type":"string","value":"internal"}],"logs":[],"processID":"p1","warnings":["parent span ID=27672be7f6292f4f is not in the trace; skipping clock skew adjustment","parent span ID=27672be7f6292f4f is not in the trace; skipping clock skew adjustment","parent span ID=27672be7f6292f4f is not in the trace; skipping clock skew adjustment","parent span ID=27672be7f6292f4f is not in the trace; skipping clock skew adjustment","parent span ID=27672be7f6292f4f is not in th