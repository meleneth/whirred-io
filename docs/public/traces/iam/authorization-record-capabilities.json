ID":"6bc59c52d4fe42587c5f3e5d2b4a026c","spanID":"a94f02fc7565bba9"}],"startTime":1789289944266138,"duration":370,"tags":[{"key":"otel.scope.name","type":"string","value":"OpenTelemetry::Instrumentation::PG"},{"key":"otel.scope.version","type":"string","value":"0.30.1"},{"key":"db.collection.name","type":"string","value":"pg_class"},{"key":"db.name","type":"string","value":"account-db_production"},{"key":"db.operation","type":"string","value":"SELECT"},{"key":"db.statement","type":"string","value":"SELECT c.relname FROM pg_class c LEFT JOIN pg_namespace n ON n.oid = c.relnamespace WHERE n.nspname = ANY (current_schemas(?)) AND c.relkind IN (?,?,?,?,?) ?"},{"key":"db.system","type":"string","value":"postgresql"},{"key":"db.user","type":"string","value":"account-db-production-user"},{"key":"net.peer.ip","type":"string","value":"172.21.0.25"},{"key":"net.peer.name","type":"string","value":"account-db"},{"key":"net.peer.port","type":"int64","value":5432},{"key":"net.transport","type":"string","value":"ip_tcp"},{"key":"span.kind","type":"string","value":"client"}],"logs":[],"processID":"p1","warnings":null},{"traceID":"6bc59c52d4fe42587c5f3e5d2b4a026c","spanID":"e2e4baea51be64d4","operationName":"SELECT account-db_production","references":[{"refType":"CHILD_OF","traceID":"6bc59c52d4fe42587c5f3e5d2b4a026c","spanID":"a94f02fc7565bba9"}],"startTime":1789289944266879,"duration":2001,"tags":[{"key":"otel.scope.name","type":"string","value":"OpenTelemetry::Instrumentation::PG"},{"key":"otel.scope.version","type":"string","value":"0.30.1"},{"key":"db.collection.name","type":"string","value":"pg_attribute"},{"key":"db.name","type":"string","value":"account-db_production"},{"key":"db.operation","type":"string","value":"SELECT"},{"key":"db.statement","type":"string","value":"SELECT a.attname, format_type(a.atttypid, a.atttypmod),\n       pg_get_expr(d.adbin, d.adrelid), a.attnotnull, a.atttypid, a.atttypmod,\n       c.collname, col_description(a.attrelid, a.attnum) AS comment,\n       attidentity AS identity,\n       attgenerated as attgenerated\n  FROM pg_attribute a\n  LEFT JOIN pg_attrdef d ON a.attrelid = d.adrelid AND a.attnum = d.adnum\n  LEFT JOIN pg_type t ON a.atttypid = t.oid\n  LEFT JOIN pg_collation c ON a.attcollation = c.oid AND a.attcollation <> t.typcollation\n WHERE a.attrelid = ?::regclass\n   AND a.attnum > ? AND NOT a.attisdropped\n ORDER BY a.attnum\n ?"},{"key":"db.system","type":"string","value":"postgresql"},{"key":"db.user","type":"string","value":"account-db-production-user"},{"key":"net.peer.ip","type":"string","value":"172.21.0.25"},{"key":"net.peer.name","type":"string","value":"account-db"},{"key":"net.peer.port","type":"int64","value":5432},{"key":"net.transport","type":"string","value":"ip_tcp"},{"key":"span.kind","type":"string","value":"client"}],"logs":[],"processID":"p1","warnings":null},{"traceID":"6bc59c52d4fe42587c5f3e5d2b4a026c","spanID":"c8a0858387103a21","operationName":"account-db_production","references":[{"refType":"CHILD_OF","traceID":"6bc59c52d4fe42587c5f3e5d2b4a026c","spanID":"a94f02fc7565bba9"}],"startTime":1789289944289122,"duration":1654,"tags":[{"key":"otel.scope.name","type":"string","value":"OpenTelemetry::Instrumentation::PG"},{"key":"otel.scope.version","type":"string","value":"0.30.1"},{"key":"db.collection.name","type":"string","value":"roots"},{"key":"db.name","type":"string","value":"account-db_production"},{"key":"db.statement","type":"string","value":"WITH RECURSIVE roots(root_id, organization_id, seed_ids) AS (\n  VALUES ($?::uuid, $?::uuid, $?::uuid[])\n),\naccount_ancestry(root_id, organization_id, id, parent_account_id, name, level, path) AS (\n  SELECT roots.root_id, roots.organization_id, accounts.id, accounts.parent_account_id, accounts.name, ? AS level, ARRAY[accounts.id]::uuid[] AS path\n  FROM roots\n  INNER JOIN accounts ON accounts.id = roots.root_id\n\n  UNION ALL\n\n  SELECT account_ancestry.root_id, account_ancestry.organization_id, parents.id, parents.parent_account_id, parents.name, account_ancestry.level + ?, account_ancestry.path || parents.id\n  FROM account_ancestry\n  INNER JOIN roots ON roots.root_id = account_ancestry.root_id\n  INNER JOIN accounts parents ON parents.id = account_ancestry.parent_account_id\n  WHERE parents.id = ANY(roots.seed_ids)\n    AND NOT parents.id = ANY(account_ancestry.path)\n    AND account_ancestry.level + ? < ?\n)\nSELECT root_id, organization_id, id, parent_account_id, name, level\nFROM account_ancestry\nORDER BY root_id, level DESC\n ?"},{"key":"db.system","type":"string","value":"postgresql"},{"key":"db.user","type":"string","value":"account-db-production-user"},{"key":"net.peer.ip","type":"string","value":"172.21.0.25"},{"key":"net.peer.name","type":"string","value":"account-db"},{"key":"net.peer.port","type":"int64","value":5432},{"key":"net.transport","type":"string","value":"ip_tcp"},{"key":"span.kind","type":"string","value":"client"}],"logs":[],"processID":"p1","warnings":null},{"traceID":"6bc59c52d4fe42587c5f3e5d2b4a026c","spanID":"ef3147f9beebd189","operationName":"organization_accounts.lookup","references":[{"refType":"CHILD_OF","traceID":"6bc59c52d4fe42587c5f3e5d2b4a026c","spanID":"a94f02fc7565bba9"}],"startTime":1789289944270835,"duration":16983,"tags":[{"key":"otel.scope.name","type":"string","value":"account-service"},{"key":"phase.elapsed_ms","type":"float64","value":16.961340996203944},{"key":"scope.count","type":"int64","value":1},{"key":"span.kind","type":"string","value":"internal"}],"logs":[],"processID":"p1","warnings":null},{"traceID":"6bc59c52d4fe42587c5f3e5d2b4a026c","spanID":"163772af2f631d76","operationName":"SELECT organization-db_production","references":[{"refType":"CHILD_OF","traceID":"6bc59c52d4fe42587c5f3e5d2b4a026c","spanID":"ef3147f9beebd189"}],"startTime":1789289944278195,"duration":329,"tags":[{"key":"otel.scope.name","type":"string","value":"OpenTelemetry::Instrumentation::PG"},{"key":"otel.scope.version","type":"string","value":"0.30.1"},{"key":"db.col